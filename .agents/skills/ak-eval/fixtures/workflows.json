      "title": "Authorized exception",
      "owner": "business-analyst + authority owner",
      "inputs": "exception request, reason, approver scope, expiry",
      "ruleId": "BR-02",
      "rule": "An exception requires a scoped approver, recorded reason and active validity.",
      "invariant": "no privilege from an expired/revoked exception",
      "contention": "revocation during approval",
      "caseIds": {
        "success": "WF-02-SUCCESS",
        "denied": "WF-02-DENIED",
        "recovery": "WF-02-RECOVERY",
        "contention": "WF-02-CONTENTION"
