      "inputs": "source revision, row IDs, checkpoint",
      "ruleId": "BR-08",
      "rule": "A resumed import applies each valid row once from a durable checkpoint.",
      "invariant": "no duplicate row and checkpoint monotonic",
      "contention": "competing workers",
      "caseIds": {
        "success": "WF-08-SUCCESS",
        "denied": "WF-08-DENIED",
        "recovery": "WF-08-RECOVERY",
        "contention": "WF-08-CONTENTION"
