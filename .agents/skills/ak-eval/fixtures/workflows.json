      "inputs": "stock, hold TTL, tenant, request ID",
      "ruleId": "BR-04",
      "rule": "A committed hold consumes one available unit and expiry returns it once.",
      "invariant": "stock plus active holds is conserved",
      "contention": "competing holds",
      "caseIds": {
        "success": "WF-04-SUCCESS",
