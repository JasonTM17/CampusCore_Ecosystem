      "inputs": "tenant, grant version, principal",
      "ruleId": "BR-05",
      "rule": "A request must match tenant and a current grant version.",
      "invariant": "revoked access never succeeds",
      "contention": "revocation during request",
      "caseIds": {
        "success": "WF-05-SUCCESS",
        "denied": "WF-05-DENIED",
        "recovery": "WF-05-RECOVERY",
