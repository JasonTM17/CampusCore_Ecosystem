    {
      "id": "WF-01",
      "slug": "multi-level-approval",
      "group": "Business process",
      "title": "Multi-level approval",
      "owner": "business-analyst + implementation owner",
      "inputs": "request, actor roles, policy revision",
      "ruleId": "BR-01",
      "rule": "Only distinct authorized approvers may advance their own ordered level.",
      "invariant": "level order and one decision per level",
      "contention": "parallel approvals",
      "caseIds": {
        "success": "WF-01-SUCCESS",
        "denied": "WF-01-DENIED",
        "recovery": "WF-01-RECOVERY",
        "contention": "WF-01-CONTENTION"
      },
      "source": "references/workflows/multi-level-approval.md"
    },
    {
      "id": "WF-02",
      "slug": "authorized-exception",
