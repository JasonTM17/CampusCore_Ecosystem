      "inputs": "period, plan limit, usage key",
      "ruleId": "BR-06",
      "rule": "Usage is idempotent and must not exceed the period limit.",
      "invariant": "used units never exceed limit",
      "contention": "competing usage",
      "caseIds": {
        "success": "WF-06-SUCCESS",
        "denied": "WF-06-DENIED",
