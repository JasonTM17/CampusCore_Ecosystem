# Android emulator uses 10.0.2.2 to reach the local API on port 4010.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4010/api/v1

# preview = bundled sample data, no network. live = real API calls.
EXPO_PUBLIC_API_MODE=live

# Set only by the local EAS profile when its non-development Android build needs local HTTP.
# The accepted host is still restricted to localhost, 127.0.0.1, 10.0.2.2 or ::1.
# EXPO_PUBLIC_ALLOW_CLEARTEXT_LOCAL=1

# Optional local portal origin. An unset portal disables release hand-offs.
# EXPO_PUBLIC_PORTAL_URL=

# Optional local identity issuer when it differs from the API host.
# EXPO_PUBLIC_ISSUER_URL=

# Assistant transport + lane feature flags (optional overrides).
# EXPO_PUBLIC_ASSISTANT_TRANSPORT=
# EXPO_PUBLIC_LANE_DEAN=
# EXPO_PUBLIC_LANE_STAFF=
# EXPO_PUBLIC_LANE_ADMIN=
# EXPO_PUBLIC_LANE_CHECKIN=

# EXPO_PUBLIC_* values are embedded in the app bundle — never put secrets here.
# See docs/ecosystem/mobile-environments.md for the three run modes.
