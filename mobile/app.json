{
  "expo": {
    "name": "CampusUTE",
    "slug": "campuscore-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "campuscore",
    "ios": {
      "bundleIdentifier": "io.campuscore.mobile",
      "associatedDomains": [
        "applinks:www.campusute.io.vn"
      ]
    },
    "android": {
      "package": "io.campuscore.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.campusute.io.vn",
              "path": "/news"
            },
            {
              "scheme": "https",
              "host": "www.campusute.io.vn",
              "path": "/docs"
            },
            {
              "scheme": "https",
              "host": "www.campusute.io.vn",
              "path": "/careers"
            },
            {
              "scheme": "https",
              "host": "www.campusute.io.vn",
              "path": "/library"
            },
            {
              "scheme": "https",
              "host": "www.campusute.io.vn",
              "path": "/apply"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
