{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "local": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "CAMPUSUTE_MOBILE_PROFILE": "local",
        "EXPO_PUBLIC_API_MODE": "live",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4010/api/v1",
        "EXPO_PUBLIC_ISSUER_URL": "http://10.0.2.2:4010",
        "EXPO_PUBLIC_ALLOW_CLEARTEXT_LOCAL": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
