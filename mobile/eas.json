{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.campusute.io.vn/api/v1",
        "EXPO_PUBLIC_PORTAL_URL": "https://www.campusute.io.vn"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.campusute.io.vn/api/v1",
        "EXPO_PUBLIC_PORTAL_URL": "https://www.campusute.io.vn"
      }
    }
  }
}
