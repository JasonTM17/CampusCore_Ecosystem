# PostgreSQL
POSTGRES_USER=campuscore
POSTGRES_PASSWORD=
POSTGRES_DB=campuscore_restful
POSTGRES_HOST_PORT=5432

# local-dev fills empty required Compose secrets with per-checkout random values.
# Keep them in this ignored file and never commit them.
ASSISTANT_DB_PASSWORD=
HEALTH_READINESS_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
ASSISTANT_RAG_SERVICE_TOKEN=
ASSISTANT_RAG_OWNER_ASSERTION_SECRET=

# Java REST API
RESTFUL_API_HOST_PORT=4010
COOKIE_SECURE=false
FLYWAY_ENABLED=true
# Initial delay in milliseconds before academic enrolled-count reconciliation runs on startup (default: 120000).
# ACADEMIC_ENROLLED_COUNT_RECONCILE_INITIAL_DELAY_MS=60000

# Thesis RAG provider (server-only; keep disabled until a rotated key is set)
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=replace-with-a-rotated-runtime-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_CONTEXT_CHARS=6000
ASSISTANT_USER_DAILY_QUOTA=20
ASSISTANT_GLOBAL_DAILY_QUOTA=200
ASSISTANT_RETENTION_DAYS=90
# Lexical-first fast path (chatbot latency): a confident curated-KB match
# answers immediately (reasonCode ANSWERED, model curated-lexical-fast, real
# citations) without the remote RAG -> DeepSeek round-trip. Set to false to
# restore the RAG-first behaviour for every knowledge question.
ASSISTANT_LEXICAL_FAST_PATH=true
# Minimum retrieval score of the top KB document that counts as a confident
# fast-path match (per retrieval term: title phrase 3+4, content phrase 1+2;
# one term caps at 10, so 11 requires a second corroborating term — the fast
# path additionally requires >=2 terms each contributing >=6).
ASSISTANT_LEXICAL_CONFIDENT_SCORE=11

# Supabase assistant-knowledge authoring (server-only; scripts/supabase/assistant-knowledge.mjs).
# The service-role key bypasses RLS — set these only in the shell that runs the
# import/export, never in frontend code, NEXT_PUBLIC_* vars, or committed files.
# Specialized corpus: supabase/seed/assistant-specialized-knowledge.json.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=set-in-the-import-shell-only
# SUPABASE_TABLE=assistant.knowledge_document

# Host/Expo clients may talk to the published API port. Docker `web` ignores this
# and always bakes NEXT_PUBLIC_API_URL=/api/v1 (same-origin Next proxy).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
# Android Emulator uses 10.0.2.2. Physical devices must use the host LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4010/api/v1
EXPO_PUBLIC_API_MODE=live

# Seeded showcase accounts. The demo passwords are published in this repository's
# history, so an account that is ACTIVE on a public host is an open administrator
# login. `DemoAccountGate` re-applies these switches on EVERY boot, which means a
# one-off SQL unlock no longer survives a restart — the switch below is the only
# thing that controls the account state.
#
#   DEMO_ACCOUNTS_ENABLED       server-side: ACTIVE (true) or LOCKED (false)
#   DEMO_ACCOUNTS_ROLES         optional scope (e.g. STUDENT) — only demo accounts
#                               holding one of these roles stay ACTIVE while the
#                               gate is enabled; the rest of the demo list LOCKED.
#   NEXT_PUBLIC_SHOW_DEMO_...   client-side quick-fill panel
#
# The local demo overlay enables demo accounts and browser quick-fill.
# Rate-limit trust switches (production proxy in front of the API):
# RATE_LIMIT_TRUST_PROXY_HEADERS=true   # trust rightmost X-Forwarded-For (Render/Vercel/Nginx)
# RATE_LIMIT_TRUST_REAL_IP=true         # additionally trust X-Real-IP (only for proxies that set it)
# ---------------------------------------------------------------------------
# Docker Compose overrides (docker-compose.yml consumes these; host port
# defaults below are the compose defaults).
# ---------------------------------------------------------------------------
FRONTEND_HOST_PORT=3000
RESTFUL_API_HOST_PORT=4010
POSTGRES_HOST_PORT=5432
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Internal assistant wiring. ASSISTANT_RAG_SERVICE_TOKEN is the shared secret
# between restful-api and the rag-service sidecar — generate one per cluster
# (openssl rand -base64 48); it must never leave the compose network.
# Owner assertions use a separate generated key shared only by those same two
# containers. Generate it with openssl rand -base64 48 and set
# ASSISTANT_RAG_OWNER_ASSERTION_SECRET in your shell or local .env before Compose startup.
# Never reuse the service token, JWT_SECRET, or JWT_REFRESH_SECRET.
ASSISTANT_QUOTA_ENFORCED=true
# ASSISTANT_RAG_SERVICE_TOKEN=change-me-rag-service-token

# Database pool tuning consumed by the API container (compose defaults).
DB_CONNECTION_TIMEOUT_MS=2000
DB_VALIDATION_TIMEOUT_MS=1000
JAVA_API_ORIGIN=http://restful-api:4010

# ---------------------------------------------------------------------------
# Notifications email. MAIL_ENABLED defaults to false in compose, so the mail
# pipeline stays offline unless explicitly switched on; Mailpit is the local
# receiver (UI on MAILPIT_UI_HOST_PORT). A production relay needs real SMTP
# credentials here — never commit them, use the environment or secret store.
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_FROM=no-reply@campuscore.local
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false

# ---------------------------------------------------------------------------
# Thesis report object storage. provider=local writes under the container's
# storage volume; provider=database stores the bytes in
# thesis_group_report.file_data (durable, no external service); provider=supabase
# requires the bucket, plus the same SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# pair documented above (the key bypasses RLS — production environments only).
# Production MUST NOT stay on local: the file is lost on every redeploy. See
# docs/integrations/thesis-report-storage.md.
# ---------------------------------------------------------------------------
THESIS_REPORT_STORAGE_PROVIDER=local
THESIS_REPORT_STORAGE_BUCKET=thesis-reports

# ---------------------------------------------------------------------------
# Direct datasource override — only needed when the API jar runs OUTSIDE the
# compose network (mvn spring-boot:run against a remote DB such as Neon). In
# compose these resolve to the internal postgres service automatically.
# Values are secrets: set them in your shell or gitignored .env, never commit.
# ---------------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/campuscore_restful
# SPRING_DATASOURCE_USERNAME=campuscore
# SPRING_DATASOURCE_PASSWORD=set-in-secret-store

# Split assistant datasource (production layout; local shares the main DB).
# ASSISTANT_DB_URL=jdbc:postgresql://<host>:5432/campuscore_restful
# ASSISTANT_DB_USERNAME=campuscore_assistant_runtime

# Public origin used when building links inside outbound emails.
# APP_PUBLIC_BASE_URL=http://localhost:3000

# Shared edge token — required ONLY when RATE_LIMIT_TRUST_PROXY_HEADERS=true
# behind a proxy that injects it; otherwise leave unset.
# RATE_LIMIT_PROXY_TOKEN=set-in-secret-store

# OIDC issuer + web BFF (docs/ecosystem/identity-contract.md). All optional
# locally; the encryption key is a secret and IDENTITY_DEV_KEYGEN must never
# be enabled outside local development.
# IDENTITY_OIDC_ENABLED=false
# IDENTITY_ISSUER_URI=https://id.campusute.io.vn
# IDENTITY_TOKEN_ENCRYPTION_KEY=set-in-secret-store
# IDENTITY_BFF_ENABLED=false
# IDENTITY_DEV_KEYGEN=true
