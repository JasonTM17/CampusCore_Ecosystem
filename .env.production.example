# Copy to .env.production on the VPS and replace every placeholder.
# This file intentionally contains no credentials and is safe to track.
CAMPUSCORE_IMAGE_REGISTRY=docker.io/nguyenson1710
CAMPUSCORE_IMAGE_TAG=latest
CAMPUSCORE_DOMAIN=campus.example.edu
ACME_EMAIL=ops@example.edu
POSTGRES_USER=campuscore
POSTGRES_DB=campuscore_restful

# Keep false until a newly rotated DeepSeek key is provisioned in
# ops/secrets/deepseek_api_key. The browser never receives this value.
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=8000
DEEPSEEK_MAX_OUTPUT_TOKENS=800

# Supabase is the production authoring/publish source. Set true only after
# the protected assistant schema and service-role file have been verified.
ASSISTANT_SUPABASE_ENABLED=false
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SCHEMA=assistant

ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_CONTEXT_CHARS=6000
ASSISTANT_USER_DAILY_QUOTA=20
ASSISTANT_GLOBAL_DAILY_QUOTA=200
ASSISTANT_RETENTION_DAYS=90

# Demo accounts must stay locked on any public host (migration V48 ships them
# LOCKED; this switch re-locks on every boot). Never set true in production.
DEMO_ACCOUNTS_ENABLED=false

# Public origin used in outbound email links.
APP_PUBLIC_BASE_URL=https://campus.example.edu

# Trusted-proxy rate limiting: Caddy terminates TLS and sets X-Forwarded-For.
# RATE_LIMIT_TRUST_PROXY_HEADERS=true
# RATE_LIMIT_PROXY_TOKEN=set-in-secret-store

# Outbound mail (2FA OTP, notifications). Password via ops/secrets/, not here.
# MAIL_ENABLED=true
# SPRING_MAIL_HOST=smtp.example.edu
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=campusute
# MAIL_FROM=no-reply@campusute.io.vn

# External/split datasources when the API does not use the compose postgres
# (e.g. Neon) or when the assistant pool runs on a dedicated role.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=campuscore
# ASSISTANT_DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# ASSISTANT_DB_USERNAME=campuscore_assistant_runtime

# Credit-limit override: 0 = rule-driven (recommended); >0 forces a flat cap.
REGISTRATION_CREDIT_LIMIT_OVERRIDE=0

# OIDC issuer for web SSO / mobile sign-in (issuer host id.campusute.io.vn).
# IDENTITY_OIDC_ENABLED=true
# IDENTITY_ISSUER_URI=https://id.campusute.io.vn
# IDENTITY_BFF_ENABLED=true
