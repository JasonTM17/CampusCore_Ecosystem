# Local course-demo URL used for canonical metadata, sitemap, and manifest generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default API base path for browser requests. The Next.js proxy forwards to Java.
NEXT_PUBLIC_API_URL=/api/v1

# Server-side proxy target (SSR/API routes reach the Java API directly).
# Docker builds bake JAVA_API_ORIGIN via a build arg instead.
# BACKEND_INTERNAL_ORIGIN=http://localhost:4010
# JAVA_API_ORIGIN=http://restful-api:4010

# Edge→backend shared secret for proxied routes (only when the edge injects it).
# CAMPUSCORE_PROXY_TOKEN=set-in-secret-store

# Identity BFF lane + allowed surface hosts (see docs/ecosystem/environment.md).
# NEXT_PUBLIC_BFF_LANE=
# NEXT_PUBLIC_SURFACE_HOSTS=

# Slim Docker image: enables `output: 'standalone'` in next.config.mjs.
# OUTPUT_STANDALONE=true

# Custom filesystem path for site appearance JSON persistence (default: .data/campuscore-site-appearance.json).
# SITE_APPEARANCE_PATH=

# Custom Next.js build output directory for concurrent builds/verification (default: .next).
# NEXT_DIST_DIR=

# Demo quick-fill (local evaluation only — values are inlined into the public
# bundle; keep unset on any public deployment):
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
# NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=
# NEXT_PUBLIC_DEMO_LECTURER_PASSWORD=
# NEXT_PUBLIC_DEMO_DEAN_PASSWORD=
